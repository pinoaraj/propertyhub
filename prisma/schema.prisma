generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROPERTY_MANAGER
  TENANT
  SERVICE_TECH
}

enum TicketStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  URGENT
}

enum TicketCategory {
  PLUMBING
  ELECTRICAL
  STRUCTURAL
  HVAC
  APPLIANCE
  SECURITY
  CLEANING
  PAINTING
  LOCKSMITH
  GENERAL
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  emailVerified     DateTime?
  name              String?
  image             String?
  password          String?
  role              UserRole           @default(TENANT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  accounts          Account[]
  sessions          Session[]
  connectedAccounts ConnectedAccount[]
  properties        Property[]         @relation("PropertyManager")
  units             Unit[]             @relation("UnitTenant")
  assignedTickets   MaintenanceTicket[] @relation("AssignedTechnician")
  createdTickets    MaintenanceTicket[] @relation("TicketCreator")
  tasks             Task[]             @relation("TaskAssignee")
  chatMessages      ChatMessage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ConnectedAccount {
  id            String           @id @default(cuid())
  userId        String
  provider      CalendarProvider
  providerAccountId String
  accessToken   String           @db.Text
  refreshToken  String?          @db.Text
  tokenExpiry   DateTime?
  calendarId    String?
  scopes        String[]
  isActive      Boolean          @default(true)
  lastSyncAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("connected_accounts")
}

model Property {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  zipCode     String
  country     String   @default("US")
  description String?  @db.Text
  managerId   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager User       @relation("PropertyManager", fields: [managerId], references: [id])
  units   Unit[]

  @@index([managerId])
  @@map("properties")
}

model Unit {
  id          String     @id @default(cuid())
  unitNumber  String
  propertyId  String
  tenantId    String?
  bedrooms    Int        @default(1)
  bathrooms   Float      @default(1)
  areaSqFt    Int?
  rentAmount  Decimal    @db.Decimal(10, 2)
  depositAmount Decimal? @db.Decimal(10, 2)
  leaseStart  DateTime?
  leaseEnd    DateTime?
  isOccupied  Boolean    @default(false)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant      User?      @relation("UnitTenant", fields: [tenantId], references: [id])
  tickets     MaintenanceTicket[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
  @@index([tenantId])
  @@map("units")
}

model MaintenanceTicket {
  id              String        @id @default(cuid())
  title           String
  description     String        @db.Text
  category        TicketCategory
  priority        TicketPriority @default(NORMAL)
  status          TicketStatus  @default(PENDING)
  unitId          String
  reportedById    String
  assignedToId    String?
  estimatedCost   Decimal?      @db.Decimal(10, 2)
  actualCost      Decimal?      @db.Decimal(10, 2)
  scheduledAt     DateTime?
  startedAt       DateTime?
  resolvedAt      DateTime?
  calendarEventId String?
  calendarProvider CalendarProvider?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  unit        Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  reportedBy  User              @relation("TicketCreator", fields: [reportedById], references: [id])
  assignedTo  User?             @relation("AssignedTechnician", fields: [assignedToId], references: [id])
  events      TicketEvent[]
  chatMessages ChatMessage[]
  tasks       Task[]

  @@index([unitId])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@map("maintenance_tickets")
}

model TicketEvent {
  id          String   @id @default(cuid())
  ticketId    String
  type        String
  description String   @db.Text
  metadata    Json?
  createdById String?
  createdAt   DateTime @default(now())

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_events")
}

model Task {
  id              String      @id @default(cuid())
  title           String
  description     String?     @db.Text
  status          TaskStatus  @default(PENDING)
  dueDate         DateTime
  completedAt     DateTime?
  assigneeId      String
  ticketId        String?
  calendarEventId String?
  calendarProvider CalendarProvider?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  assignee User     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  ticket   MaintenanceTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([assigneeId])
  @@index([dueDate])
  @@index([status])
  @@map("tasks")
}

model ChatMessage {
  id          String   @id @default(cuid())
  role        String
  content     String   @db.Text
  userId      String
  ticketId    String?
  toolCalls   Json?
  toolResults Json?
  createdAt   DateTime @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket  MaintenanceTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticketId])
  @@map("chat_messages")
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actor])
  @@index([createdAt])
  @@map("audit_logs")
}